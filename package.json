{
  "name": "word-ai",
  "version": "1.2.0",
  "description": "Word LLM 智能文字处理插件",
  "main": "src/taskpane/taskpane.js",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:prod": "webpack --mode production && node scripts/build-manifest.js",
    "test": "vitest run",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "sideload": "office-addin-dev-settings sideload manifest.xml",
    "unload": "office-addin-dev-settings clear manifest.xml"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.7",
    "office-addin-debugging": "^6.1.1",
    "office-addin-dev-certs": "^2.0.9",
    "office-addin-dev-settings": "^3.1.1",
    "style-loader": "^4.0.0",
    "vitest": "^4.1.8",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.4"
  }
}
